# Google Gemini API Key (Required for summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional: for developers who want to swap or extend the LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional: for alternative model testing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API Key (Optional: for channel info and metadata, fallback is used if not provided)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase Settings (Optional: for database backup and storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
